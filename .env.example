APP_NAME="SimplifiQ Lead Automation"
APP_ENV="development"
DATABASE_URL="sqlite:///./simplifiq_leads.db"

# OpenAI is optional.
# If not configured or quota fails, the app uses fallback rule-based report generation.
OPENAI_API_KEY="your_openai_api_key_here"

# SMTP email delivery is optional.
# If not configured, the app generates the PDF but skips email delivery safely.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_gmail_app_password"
SMTP_FROM_EMAIL="your_email@gmail.com"

REPORT_OUTPUT_DIR="generated_reports"

# Google Sheets logging is optional bonus functionality.
# If disabled or not configured, the workflow continues safely.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE="google_service_account.json"
GOOGLE_SHEET_ID="your_google_sheet_id_here"
GOOGLE_SHEET_RANGE="Leads!A:G"